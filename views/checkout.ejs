<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Checkout</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Checkout</h2>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <table class="table table-bordered align-middle">
      <thead class="table-dark">
        <tr><th>Item</th><th>Qty</th><th>Subtotal</th></tr>
      </thead>
      <tbody>
        <% cart.lines.forEach((line) => { %>
          <tr>
            <td><%= line.name %></td>
            <td><%= line.quantity %></td>
            <td>SGD <%= line.lineTotal.toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><th colspan="2" class="text-end">Total</th><th>SGD <%= cart.total.toFixed(2) %></th></tr>
      </tfoot>
    </table>

    <form action="/checkout" method="POST">
      <% if (hasService) { %>
        <div class="mb-3">
          <label class="form-label">Which pet is the service for?</label>
          <select name="pet_id" class="form-select" required>
            <option value="">-- Choose a pet --</option>
            <% pets.forEach((pet) => { %>
              <option value="<%= pet.id %>"><%= pet.name %></option>
            <% }) %>
          </select>
          <% if (pets.length === 0) { %>
            <div class="form-text">You have no pets yet. <a href="/pets/new">Add a pet</a> first.</div>
          <% } %>
        </div>

        <div class="mb-3">
          <label class="form-label">Appointment date and time (9:00 - 17:00):</label>
          <input type="datetime-local" name="appointment_at" class="form-control" required>
        </div>
      <% } %>

      <% if (hasProduct) { %>
        <p class="text-muted">
          Products will be delivered by about
          <strong><%= estimatedDelivery.toLocaleDateString('en-SG', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></strong>
          (2 working days).
        </p>
      <% } %>

      <div class="alert alert-info">
        Payment is simulated for this project. No real money is charged and no payment method is needed.
      </div>

      <a href="/cart" class="btn btn-outline-secondary">Back to Cart</a>
      <button type="submit" class="btn btn-success">Confirm Order</button>
    </form>
  </div>
</body>
</html>
