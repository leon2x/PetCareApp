<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Shop</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/petcare.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5" id="main-content">
    <h2 class="mb-4">Pet Care Shop</h2>
    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <a href="/cart" class="btn btn-outline-primary mb-4">View Cart (<%= cart.count %>)</a>

    <% [{ title: 'Services', items: services }, { title: 'Products', items: products }].forEach((group) => { %>
      <h4 class="mt-3"><%= group.title %></h4>
      <div class="row g-3 mb-4">
        <% group.items.forEach((item) => { %>
          <div class="col-md-3">
            <div class="card h-100">
              <div class="card-body d-flex flex-column">
                <h5 class="card-title"><%= item.name %></h5>
                <p class="card-text">SGD <%= item.price.toFixed(2) %></p>
                <form action="/cart/add" method="POST" class="mt-auto">
                  <input type="hidden" name="itemId" value="<%= item.id %>">
                  <button type="submit" class="btn btn-success btn-sm">Add to Cart</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% }) %>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/petcare.js"></script>
</body>
</html>
