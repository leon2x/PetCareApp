<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Order Confirmation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>

    <h2 class="mb-4">Order Receipt</h2>

    <div class="card mb-4">
      <div class="card-body">
        <p><strong>Order number:</strong> <%= order.order_ref %></p>
        <p><strong>Placed on:</strong> <%= new Date(order.created_at).toLocaleString('en-SG') %></p>
        <p><strong>Status:</strong> <span class="badge bg-success"><%= order.order_status %></span>
           <span class="text-muted">(payment: <%= order.payment_status %>, simulated)</span></p>
        <% if (order.appointment_at) { %>
          <p><strong>Appointment<% if (order.pet_name) { %> for <%= order.pet_name %><% } %>:</strong>
            <%= new Date(order.appointment_at).toLocaleString('en-SG', { dateStyle: 'full', timeStyle: 'short' }) %></p>
        <% } %>
        <% if (order.estimated_delivery) { %>
          <p><strong>Estimated delivery:</strong>
            <%= new Date(order.estimated_delivery).toLocaleDateString('en-SG', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <% } %>
      </div>
    </div>

    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr><th>Item</th><th>Type</th><th>Unit price</th><th>Qty</th><th>Subtotal</th></tr>
      </thead>
      <tbody>
        <% items.forEach((item) => { %>
          <tr>
            <td><%= item.item_name %></td>
            <td><%= item.item_type %></td>
            <td>SGD <%= Number(item.unit_price).toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>SGD <%= (Number(item.unit_price) * item.quantity).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><th colspan="4" class="text-end">Total (<%= order.currency.toUpperCase() %>)</th><th><%= Number(order.total).toFixed(2) %></th></tr>
      </tfoot>
    </table>

    <a href="/orders" class="btn btn-outline-primary">My Orders</a>
    <a href="/shop" class="btn btn-success">Continue Shopping</a>
  </div>
</body>
</html>
