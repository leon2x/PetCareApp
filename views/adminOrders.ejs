<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin - All Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/petcare.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5" id="main-content">
    <h2 class="mb-4">All Orders</h2>

    <% if (orders.length === 0) { %>
      <p>No orders have been placed yet.</p>
    <% } else { %>
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
          <tr><th>Order number</th><th>Customer</th><th>Placed on</th><th>Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach((order) => { %>
            <% const badgeClass = { CONFIRMED: 'bg-success', COMPLETED: 'bg-secondary', CANCELLED: 'bg-danger' }[order.order_status] || 'bg-dark'; %>
            <tr>
              <td><%= order.order_ref %></td>
              <td><%= order.customer_name %> (<%= order.username %>)</td>
              <td><%= new Date(order.created_at).toLocaleString('en-SG') %></td>
              <td>SGD <%= Number(order.total).toFixed(2) %></td>
              <td><span class="badge <%= badgeClass %>"><%= order.order_status %></span></td>
              <td><a href="/admin/orders/<%= order.id %>" class="btn btn-sm btn-dark">View</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>

    <a href="/admin/dashboard" class="btn btn-secondary">Back to Dashboard</a>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/petcare.js"></script>
</body>
</html>
