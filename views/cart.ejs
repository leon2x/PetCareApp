<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/petcare.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5" id="main-content">
    <h2 class="mb-4">Your Cart</h2>
    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <% if (cart.lines.length === 0) { %>
      <p>Your cart is empty.</p>
      <a href="/shop" class="btn btn-success">Browse the Shop</a>
    <% } else { %>
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>Item</th>
            <th>Type</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Subtotal</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% cart.lines.forEach((line) => { %>
            <tr>
              <td><%= line.name %></td>
              <td><%= line.type %></td>
              <td>SGD <%= line.price.toFixed(2) %></td>
              <td>
                <form action="/cart/update" method="POST" class="d-flex">
                  <input type="hidden" name="itemId" value="<%= line.id %>">
                  <input type="number" name="quantity" value="<%= line.quantity %>" min="1" max="10" class="form-control form-control-sm me-2" style="width: 80px;">
                  <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                </form>
              </td>
              <td>SGD <%= line.lineTotal.toFixed(2) %></td>
              <td>
                <form action="/cart/remove" method="POST">
                  <input type="hidden" name="itemId" value="<%= line.id %>">
                  <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr>
            <th colspan="4" class="text-end">Total</th>
            <th colspan="2">SGD <%= cart.total.toFixed(2) %></th>
          </tr>
        </tfoot>
      </table>

      <a href="/shop" class="btn btn-outline-secondary">Continue Shopping</a>
      <a href="/checkout" class="btn btn-success">Checkout</a>
    <% } %>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/petcare.js"></script>
</body>
</html>
