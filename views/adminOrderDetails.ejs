<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin - Order Details</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/petcare.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5" id="main-content">
    <% if (messages && messages.length > 0) { %>
      <div class="alert alert-success"><%= messages[0] %></div>
    <% } %>
    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger"><%= errors[0] %></div>
    <% } %>

    <h2 class="mb-4">Order <%= order.order_ref %></h2>
    <% const badgeClass = { CONFIRMED: 'bg-success', COMPLETED: 'bg-secondary', CANCELLED: 'bg-danger' }[order.order_status] || 'bg-dark'; %>

    <div class="card mb-4">
      <div class="card-body">
        <p><strong>Customer:</strong> <%= order.customer_name %> (<%= order.username %>)</p>
        <p><strong>Placed on:</strong> <%= new Date(order.created_at).toLocaleString('en-SG') %></p>
        <p><strong>Status:</strong> <span class="badge <%= badgeClass %>"><%= order.order_status %></span>
           <span class="text-muted">(payment: <%= order.payment_status %>, simulated)</span></p>
        <% if (order.appointment_at) { %>
          <p><strong>Appointment<% if (order.pet_name) { %> for <%= order.pet_name %><% } %>:</strong>
            <%= new Date(order.appointment_at).toLocaleString('en-SG', { dateStyle: 'full', timeStyle: 'short' }) %></p>
        <% } %>
        <% if (order.estimated_delivery) { %>
          <p><strong>Estimated delivery:</strong>
            <%= new Date(order.estimated_delivery).toLocaleDateString('en-SG', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        <% } %>
      </div>
    </div>

    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr><th>Item</th><th>Type</th><th>Unit price</th><th>Qty</th><th>Subtotal</th></tr>
      </thead>
      <tbody>
        <% items.forEach((item) => { %>
          <tr>
            <td><%= item.item_name %></td>
            <td><%= item.item_type %></td>
            <td>SGD <%= Number(item.unit_price).toFixed(2) %></td>
            <td><%= item.quantity %></td>
            <td>SGD <%= (Number(item.unit_price) * item.quantity).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot>
        <tr><th colspan="4" class="text-end">Total (<%= order.currency.toUpperCase() %>)</th><th><%= Number(order.total).toFixed(2) %></th></tr>
      </tfoot>
    </table>

    <form action="/admin/orders/<%= order.id %>/status" method="POST" class="d-flex align-items-center mb-4">
      <label class="me-2"><strong>Change status:</strong></label>
      <select name="status" class="form-select me-2" style="width: 200px;">
        <% statuses.forEach((s) => { %>
          <option value="<%= s %>" <%= s === order.order_status ? 'selected' : '' %>><%= s %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-primary">Update</button>
    </form>

    <a href="/admin/orders" class="btn btn-secondary">Back to All Orders</a>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/petcare.js"></script>
</body>
</html>
