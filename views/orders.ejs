<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/petcare.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5" id="main-content">
    <h2 class="mb-4">My Orders</h2>

    <% if (orders.length === 0) { %>
      <div class="empty-state">
        <div class="big" aria-hidden="true">🛍️</div>
        <h2 class="h5">No orders yet</h2>
        <p class="text-secondary">Services and pet products you buy will show up here.</p>
        <a href="/shop" class="btn btn-primary">Browse the Shop</a>
      </div>
    <% } else { %>
      <div class="table-responsive"><table class="table align-middle">
        <thead class="table-dark">
          <tr><th>Order number</th><th>Placed on</th><th>Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach((order) => { %>
            <tr>
              <td><%= order.order_ref %></td>
              <td><%= new Date(order.created_at).toLocaleString('en-SG') %></td>
              <td>SGD <%= Number(order.total).toFixed(2) %></td>
              <td><span class="badge status-<%= String(order.order_status).toLowerCase() %>"><%= order.order_status %></span></td>
              <td><a href="/orders/<%= order.id %>" class="btn btn-sm btn-primary">View Receipt</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
    <% } %>
  </div>
  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/petcare.js"></script>
</body>
</html>
