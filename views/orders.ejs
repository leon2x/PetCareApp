<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My Orders</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">My Orders</h2>

    <% if (orders.length === 0) { %>
      <p>You have no orders yet.</p>
      <a href="/shop" class="btn btn-success">Browse the Shop</a>
    <% } else { %>
      <table class="table table-bordered table-striped">
        <thead class="table-dark">
          <tr><th>Order number</th><th>Placed on</th><th>Total</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <% orders.forEach((order) => { %>
            <tr>
              <td><%= order.order_ref %></td>
              <td><%= new Date(order.created_at).toLocaleString('en-SG') %></td>
              <td>SGD <%= Number(order.total).toFixed(2) %></td>
              <td><%= order.order_status %></td>
              <td><a href="/orders/<%= order.id %>" class="btn btn-sm btn-primary">View Receipt</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
